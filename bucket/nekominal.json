{
    "version": "0.0.21",
    "description": "A Windows terminal in Rust for coding agents: Claude Code, including its full-screen mode, runs in it",
    "homepage": "https://github.com/KoukeNeko/scoop-bucket#nekominal",
    "license": "Proprietary",
    "architecture": {
        "64bit": {
            "url": "https://github.com/KoukeNeko/scoop-bucket/releases/download/nekominal-v0.0.21/Nekominal-0.0.21-windows-x64.zip",
            "hash": "8e159c930d263df0765539735884a13b84e9735e5e8165167e8ef4facc315008"
        }
    },
    "bin": "Nekominal.exe",
    "shortcuts": [
        [
            "Nekominal.exe",
            "Nekominal"
        ]
    ],
    "pre_install": "Get-Process Nekominal -ErrorAction SilentlyContinue | Stop-Process -Force -PassThru | Wait-Process",
    "pre_uninstall": [
        "Get-Process Nekominal -ErrorAction SilentlyContinue | Stop-Process -Force -PassThru | Wait-Process",
        "if ($cmd -eq 'uninstall') { Remove-Item 'HKCU:\\Software\\Classes\\Directory\\shell\\Nekominal', 'HKCU:\\Software\\Classes\\Directory\\Background\\shell\\Nekominal' -Recurse -ErrorAction SilentlyContinue }"
    ]
}
