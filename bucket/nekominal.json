        }
    },
    "env_add_path": ".",
    "shortcuts": [
        [
            "Nekominal.exe",
            "Nekominal"
        ]
    ],
    "pre_install": "Get-Process Nekominal -ErrorAction SilentlyContinue | Stop-Process -Force -PassThru | Wait-Process",
    "pre_uninstall": [
        "Get-Process Nekominal -ErrorAction SilentlyContinue | Stop-Process -Force -PassThru | Wait-Process",
        "if ($cmd -eq 'uninstall') { Remove-Item 'HKCU:\\Software\\Classes\\Directory\\shell\\Nekominal', 'HKCU:\\Software\\Classes\\Directory\\Background\\shell\\Nekominal' -Recurse -ErrorAction SilentlyContinue }"
    ]
